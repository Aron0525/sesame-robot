{
  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "provider": "duckduckgo",
        "maxResults": 3,
        "timeoutSeconds": 8,
        "cacheTtlMinutes": 5
      }
    }
  },
  "plugins": {
    "allow": [
      "wecom-openclaw-plugin",
      "memory-core",
      "codex",
      "deepseek",
      "duckduckgo"
    ],
    "entries": {
      "duckduckgo": {
        "enabled": true,
        "config": {
          "webSearch": {
            "region": "cn-zh",
            "safeSearch": "moderate"
          }
        }
      }
    }
  },
  "agents": {
    "list": [
      {
        "id": "main"
      },
      {
        "id": "sesame",
        "name": "Sesame Robot",
        "workspace": "/Users/mac/.openclaw/workspace-sesame",
        "agentDir": "/Users/mac/.openclaw/agents/sesame/agent",
        "model": "deepseek/deepseek-v4-flash",
        "skills": [],
        "memorySearch": {
          "enabled": true,
          "provider": "none",
          "sources": [
            "memory"
          ],
          "store": {
            "fts": {
              "tokenizer": "trigram"
            }
          }
        },
        "sandbox": {
          "mode": "all",
          "backend": "docker",
          "scope": "session",
          "workspaceAccess": "none",
          "docker": {
            "image": "openclaw-sandbox:bookworm-slim",
            "network": "none",
            "readOnlyRoot": true,
            "user": "sandbox",
            "capDrop": [
              "ALL"
            ],
            "pidsLimit": 128,
            "memory": "512m",
            "memorySwap": "512m",
            "cpus": 1
          }
        },
        "tools": {
          "profile": "coding",
          "allow": [
            "read",
            "web_search"
          ],
          "deny": [
            "group:runtime",
            "write",
            "edit",
            "apply_patch",
            "sessions_list",
            "sessions_history",
            "sessions_send",
            "sessions_spawn",
            "sessions_yield",
            "subagents",
            "session_status",
            "group:memory",
            "group:ui",
            "group:automation",
            "group:messaging",
            "group:nodes",
            "group:agents",
            "group:media",
            "group:openclaw"
          ],
          "exec": {
            "host": "sandbox",
            "security": "deny"
          },
          "elevated": {
            "enabled": false
          },
          "sandbox": {
            "tools": {
              "allow": [
                "read",
                "web_search"
              ],
              "deny": [
                "group:runtime",
                "write",
                "edit",
                "apply_patch",
                "sessions_list",
                "sessions_history",
                "sessions_send",
                "sessions_spawn",
                "sessions_yield",
                "subagents",
                "session_status",
                "group:memory",
                "group:ui",
                "group:automation",
                "group:messaging",
                "group:nodes",
                "group:agents",
                "group:media",
                "group:openclaw"
              ]
            }
          }
        },
        "thinkingDefault": "low",
        "contextInjection": "continuation-skip",
        "bootstrapMaxChars": 3500,
        "bootstrapTotalMaxChars": 5500,
        "contextTokens": 32768,
        "contextLimits": {
          "postCompactionMaxChars": 1200
        }
      }
    ]
  }
}
