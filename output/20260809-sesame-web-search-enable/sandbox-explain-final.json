{
  "docsUrl": "https://docs.openclaw.ai/sandbox",
  "agentId": "sesame",
  "sessionKey": "agent:sesame:main",
  "mainSessionKey": "agent:sesame:main",
  "sandbox": {
    "mode": "all",
    "scope": "session",
    "backend": "docker",
    "workspaceAccess": "none",
    "workspaceRoot": "/Users/mac/.openclaw/sandboxes",
    "effectiveHostWorkspaceRoot": "/Users/mac/.openclaw/sandboxes/agent-sesame-main-5fc3fa4a",
    "runtimeWorkdir": "/workspace",
    "workspaceMounts": [
      {
        "hostRoot": "/Users/mac/.openclaw/sandboxes/agent-sesame-main-5fc3fa4a",
        "containerRoot": "/workspace",
        "writable": false,
        "source": "workspace"
      }
    ],
    "workspaceSource": "sandbox",
    "sessionIsSandboxed": true,
    "tools": {
      "allow": [
        "read",
        "web_search"
      ],
      "deny": [
        "exec",
        "process",
        "code_execution",
        "write",
        "edit",
        "apply_patch",
        "sessions_list",
        "sessions_history",
        "sessions_send",
        "sessions_spawn",
        "sessions_yield",
        "subagents",
        "session_status",
        "memory_search",
        "memory_get",
        "browser",
        "canvas",
        "heartbeat_respond",
        "cron",
        "gateway",
        "message",
        "nodes",
        "agents_list",
        "get_goal",
        "create_goal",
        "update_goal",
        "update_plan",
        "skill_workshop",
        "image",
        "image_generate",
        "music_generate",
        "video_generate",
        "tts"
      ],
      "sources": {
        "allow": {
          "source": "agent",
          "key": "agents.list[].tools.sandbox.tools.allow"
        },
        "deny": {
          "source": "agent",
          "key": "agents.list[].tools.sandbox.tools.deny"
        }
      }
    }
  },
  "elevated": {
    "enabled": false,
    "allowedByConfig": false,
    "alwaysAllowedByConfig": false,
    "allowFrom": {},
    "failures": [
      {
        "gate": "enabled",
        "key": "agents.list[].tools.elevated.enabled"
      }
    ]
  },
  "fixIt": [
    "agents.defaults.sandbox.mode=off",
    "agents.list[].sandbox.mode=off",
    "tools.sandbox.tools.allow",
    "tools.sandbox.tools.alsoAllow",
    "tools.sandbox.tools.deny",
    "agents.list[].tools.sandbox.tools.allow",
    "agents.list[].tools.sandbox.tools.alsoAllow",
    "agents.list[].tools.sandbox.tools.deny",
    "tools.elevated.enabled"
  ]
}
