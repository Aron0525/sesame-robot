+    async def handle_mode_text(self, device_id: str, text: str, *, source: str) -> dict:
+        """Handle the fixed mode-selection dialogue before normal Agent routing."""
+        action, mode_id = classify_mode_input(
+            text, selection_pending=device_id in self.pending_mode_selection_by_device
+        )
+        if action == "prompt":
+            self.pending_mode_selection_by_device.add(device_id)
+            payload = {
+                "device_id": device_id,
+                "announcement": MODE_SELECTION_ANNOUNCEMENT,
+                "options": ["learning", "children", "work", "normal"],
+                "source": source,
+            }
+            await self.broadcast({"type": "mode.selection_required", "payload": payload})
+            return {"status": "selection_required", "pending": True, **payload}
+        if action == "switch" and mode_id is not None:
+            self.pending_mode_selection_by_device.discard(device_id)
+            changed = await self.select_mode(device_id, mode_id, source=source)
+            announcement = f"已切换到{changed['scene']['label']}模式。"
+            return {"status": "switched", "pending": False, "announcement": announcement, **changed}
+        if action == "reprompt":
+            return {"status": "selection_required", "pending": True, "announcement": MODE_SELECTION_ANNOUNCEMENT}
+        return {"status": "ignored", "pending": False}
