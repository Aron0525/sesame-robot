+bool format_discovered_gateway_uri(std::string_view hostname, uint16_t port,
+                                   char* output, size_t capacity) {
+  if (hostname.empty() || port == 0 || output == nullptr || capacity == 0) {
+    return false;
+  }
+  const std::string_view suffix = hostname.ends_with(".local") ? "" : ".local";
+  constexpr std::string_view kDeviceStreamPath = "/v1/device-stream";
+  const int written = std::snprintf(
+      output, capacity, "wss://%.*s%.*s:%u%.*s",
+      static_cast<int>(hostname.size()), hostname.data(),
+      static_cast<int>(suffix.size()), suffix.data(), port,
+      static_cast<int>(kDeviceStreamPath.size()), kDeviceStreamPath.data());
+  return written > 0 && static_cast<size_t>(written) < capacity;
+}
+
