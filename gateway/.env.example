# Copy to .env and replace all development credentials before running.
SESAME_GATEWAY_ID=gw_stream_lab
SESAME_HOST=0.0.0.0
SESAME_PORT=8766
# Local WSS: keep the private key outside the repository and chmod it to 600.
SESAME_TLS_ENABLED=true
SESAME_TLS_CERT_FILE=.tls/server-cert.pem
SESAME_TLS_KEY_FILE=.tls/server-key.pem

# JSON maps. Generate a long random token per device; never commit real values.
# Device IDs are 1-63 ASCII letters, digits, hyphens, or underscores; they cannot
# begin/end with a separator. ESP32 local URLs normalize '_' to '-', so do not use
# both forms (for example, `dev_001` and `dev-001`) in the same deployment.
SESAME_DEVICE_TOKENS={"sesame-stream-lab-001":"replace-with-a-random-device-token"}
SESAME_DEVICE_USERS={"sesame-stream-lab-001":"usr_stream_lab"}
SESAME_CONVERSATION_TTL_SECONDS=1800
SESAME_CONVERSATION_CLEANUP_INTERVAL_SECONDS=60
# Local browser dashboard. It keeps only bounded in-memory metadata by default.
SESAME_DASHBOARD_EVENT_LIMIT=500
# Keep user ASR/TTS text hidden unless a local, short-term debugging session needs it.
SESAME_DASHBOARD_DEBUG_CONTENT=true
# Recordings, logs and cache for this lab stay under this project only.
SESAME_SAVE_TEST_RECORDINGS=false
SESAME_TEST_RECORDING_DIR=runtime/test-recordings
SESAME_TEST_RECORDING_LIMIT=10
SESAME_TEST_RECORDING_MANUAL_ONLY=true

# Optional direct USB observation. When enabled, do not start `idf.py monitor`
# or an Arduino serial monitor at the same time: one process must own the port.
SESAME_SERIAL_MONITOR_ENABLED=false
SESAME_SERIAL_MONITOR_PORT=/dev/cu.usbmodem101
SESAME_SERIAL_MONITOR_BAUD_RATE=115200
# SESAME_SERIAL_MONITOR_DEVICE_ID=dev_001

# This project only runs against the real DashScope audio providers.
SESAME_ASR_PROVIDER=dashscope
SESAME_TTS_PROVIDER=dashscope
# Explicitly opt in before audio or TTS text may leave this computer.
SESAME_ALLOW_REMOTE_SPEECH=false

# DashScope cloud audio. An API key is required when either provider is dashscope.
# Workspace ID is optional: without it, the compatible public regional endpoint is used.
# API keys and Workspace IDs are region-specific. Never commit the real key.
# SESAME_DASHSCOPE_API_KEY=sk-replace-with-real-key
# SESAME_DASHSCOPE_WORKSPACE_ID=replace-with-workspace-id
SESAME_DASHSCOPE_REGION=beijing
SESAME_DASHSCOPE_ASR_MODEL=fun-asr-realtime
SESAME_DASHSCOPE_ASR_LANGUAGE=zh
SESAME_DASHSCOPE_TTS_MODEL=qwen-audio-3.0-tts-flash
SESAME_DASHSCOPE_TTS_VOICE_ID=longanhuan_v3.6
SESAME_DASHSCOPE_TIMEOUT_SECONDS=30

# Opt in before real-time web-search queries are sent to DashScope. OpenClaw
# receives no DashScope key and cannot make arbitrary network requests.
SESAME_WEB_SEARCH_ENABLED=false
SESAME_WEB_SEARCH_MODEL=qwen-plus
SESAME_WEB_SEARCH_TIMEOUT_SECONDS=15

# OpenClaw sends ASR text to the local Agent Gateway.
SESAME_PROVIDER_MODE=openclaw_sse

# Enable only after the advertised LAN address is known.
SESAME_ENABLE_MDNS=true
SESAME_MDNS_INSTANCE_NAME=Sesame Streaming Lab Gateway
SESAME_MDNS_HOSTNAME=sesame-stream-gateway
# Re-evaluate the active LAN address at this interval and republish mDNS when
# DHCP or Wi-Fi changes it. The ESP32 always rediscovers before reconnecting.
SESAME_MDNS_REFRESH_INTERVAL_SECONDS=30
# Leave unset for normal DHCP. Set only to a router-reserved/static LAN IP.
# SESAME_ADVERTISED_IPV4=192.168.1.25

# OpenClaw stays on loopback. The lab-owned SSE bridge listens on 18790 and
# forwards to the already-running OpenClaw WebSocket Gateway on 18789.
SESAME_OPENCLAW_URL=ws://127.0.0.1:18789
SESAME_OPENCLAW_SSE_URL=http://127.0.0.1:18790/v1/sesame/reply-stream
SESAME_OPENCLAW_SSE_BRIDGE_PORT=18790
# The bridge reads this existing local config only at runtime; do not copy its
# OpenClaw Gateway auth token into this project.
# SESAME_OPENCLAW_GATEWAY_CONFIG_FILE=/absolute/path/to/openclaw.json
SESAME_OPENCLAW_AGENT_ID=sesame
# SESAME_OPENCLAW_TOKEN=replace-with-openclaw-gateway-token
# Generate with: openssl rand -hex 32. Do not reuse the device token.
# SESAME_OPENCLAW_SESSION_KEY_SECRET=replace-with-a-random-secret
# When true, the trusted Voice Gateway removes only expired, HMAC-derived session sandboxes.
SESAME_OPENCLAW_SANDBOX_CLEANUP_ENABLED=false
SESAME_OPENCLAW_TIMEOUT_SECONDS=60
# All attempts share the timeout above. Keep this low for voice interaction.
SESAME_OPENCLAW_MAX_ATTEMPTS=2
SESAME_OPENCLAW_RETRY_INITIAL_DELAY_SECONDS=0.25
SESAME_OPENCLAW_RETRY_MAX_DELAY_SECONDS=1
# A cancelled/expired turn sends a narrow chat.abort for its own run ID.
SESAME_OPENCLAW_ABORT_TIMEOUT_SECONDS=3
