{
  "agents": {
    "defaults": {
      "skipBootstrap": true
    },
    "list": [
      {
        "id": "sesame",
        "name": "Sesame Robot",
        "workspace": "~/.openclaw/workspace-sesame",
        "sandbox": {
          "mode": "all",
          "scope": "agent",
          "workspaceAccess": "ro"
        },
        "tools": {
          "allow": ["read"],
          "deny": [
            "write",
            "edit",
            "apply_patch",
            "exec",
            "process",
            "web_search",
            "browser",
            "computer",
            "message",
            "sessions_list",
            "sessions_history",
            "sessions_send",
            "sessions_spawn",
            "session_status"
          ],
          "elevated": {
            "enabled": false
          }
        }
      },
      {
